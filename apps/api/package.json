    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "typescript": "^5.8.3",
